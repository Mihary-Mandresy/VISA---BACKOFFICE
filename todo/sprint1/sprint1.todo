                    [x] <String,String> separateIdCheckDossierAndIdDossier(<String> idDossierConcatidCheckDossiers):
                        <String,String> result 
                        boucle sur idDossierConcatidCheckDossiers: 
                            variable = idDossierConcatidCheckDossiers[i]
                            result.put(variable.split("-")[0],variable.split("-")[1])
                        retourner result
